@using Application.DataTransferObject;

@model IEnumerable<InscricaoDTO>;


<div id="carouselEventos" class="carousel slide" data-bs-ride="carousel">

    <div class="carousel-inner">

        @{
            bool primeiro = true; 
        }

        <h2 class="text-center">Minhas Inscrições</h2>
        

        @foreach (var item in Model)
        {                      

            <div class="carousel-item @(primeiro ? "active" : "")">

                <div class="text-center">
                   

                    <div class="mt-3">
                        <h4>@item.NomeEvento</h4>

                        <p>
                            <strong>Camisa:</strong>
                            @item.Camisa;
                        </p>

                        @if (item.Camisa == 1)
                        {
                            <p>
                                <strong>Tamanho da Camisa:</strong>
                                @item.TamanhoCamisa
                            </p>
                            <p>
                                <strong>Cor:</strong>
                                @item.Cor
                            </p>
                        }

                    </div>

                </div>

            </div>

            primeiro = false;
        }

    </div>

    <button class="carousel-control-prev"
            type="button"
            data-bs-target="#carouselEventos"
            data-bs-slide="prev">

        <span class="carousel-control-prev-icon"></span>

    </button>

    <button class="carousel-control-next"
            type="button"
            data-bs-target="#carouselEventos"
            data-bs-slide="next">

        <span class="carousel-control-next-icon"></span>

    </button>

</div>

