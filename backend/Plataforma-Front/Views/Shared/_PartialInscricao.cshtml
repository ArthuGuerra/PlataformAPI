@using Plataforma_Front.ViewModels;
@using System.Security.Claims;

@model EventoInscricaoViewModel


<div class="text-center">
   

    <form asp-action="FazerInscricaoPOST" method="post">

        <input type="hidden" asp-for="Evento.Id" />
        <input type="hidden" asp-for="Evento.Nome" />
        

        <div class="input-group mb-2">
            <input asp-for="Inscricao.TamanhoCamisa" 
            class="form-control" 
            placeholder="Tamanho da camisa ( P,M,G )" 
            required/>
        </div>

        <div class="input-group mb-2">
            <input asp-for="Inscricao.Cor" 
            class="form-control" 
            placeholder="Cor" 
            required/>
        </div>

        <div class="input-group mb-2">
            <input asp-for="Inscricao.Camisa" 
            class="form-control"            
            placeholder="Quantidade( 1 ou 0 )>" 
            required/>
        </div>

        <button type="submit" class="btn btn-primary">
            Enviar
            <i class="fa-solid fa-arrow-right-to-bracket"></i>
        </button>

    </form>
</div>