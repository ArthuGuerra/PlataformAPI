@using Plataforma_Front.ViewModels;
@using System.Security.Claims;

@model EventoInscricaoViewModel


<div class="text-center">
   

    <form asp-action="FazerInscricaoPOST" method="post">

        <input type="hidden" asp-for="Evento.Id" />
        <input type="hidden" asp-for="Evento.Nome" />
        

        <div class="input-group mb-2">
            <select asp-for="Inscricao.TamanhoCamisa" 
            class="form-control">
                <option value="">Selecione o Tamanho</option>
                <option value="P babylook">P babylook</option>
                <option value="M babylook">M babylook</option>
                <option value="P">P</option>
                <option value="M">M</option>
                <option value="G">G</option>
            </select>
        </div>

        <div class="input-group mb-2">
            <input asp-for="Inscricao.QuantidadeKm" 
            class="form-control" 
            placeholder="Quantidade de Quilômetros"/>
        </div>

        <div class="input-group mb-2">
            <input asp-for="Inscricao.QuantidadeKit"
            class="form-control"            
            placeholder="Quantidade de kits( 1 ou 0 )>"/>
        </div>

        <button type="submit" class="btn btn-primary">
            Enviar
            <i class="fa-solid fa-arrow-right-to-bracket"></i>
        </button>

    </form>
</div>