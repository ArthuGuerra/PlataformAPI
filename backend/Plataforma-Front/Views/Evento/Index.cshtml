@using Application.DataTransferObject
@using Plataforma_Front.ViewModels;

@model IEnumerable<Application.DataTransferObject.EventoDTO>;


<div id="carouselEventos" class="carousel slide" data-bs-ride="carousel">

    <div class="carousel-inner">

        @{
            bool primeiro = true; 
        }

        @foreach (var item in Model)
        {
            
            var vm = new EventoInscricaoViewModel
            {
                Evento = item,
                Inscricao = new InscricaoDTO()
            };                        


            <div class="carousel-item @(primeiro ? "active" : "")">

                <div class="text-center">

                    <img src="@item.Imagem"
                         class="d-block w-100 img-fluid"
                         alt="@item.Nome">

                    <div class="mt-3">
                        <h4>@item.Nome</h4>

                        <p>
                            <strong>Descrição:</strong>
                            @item.Descricao
                        </p>
                        <p>
                            <strong>Local:</strong>
                            @item.LocalEvento
                        </p>
                        <p>
                            <strong>Data do evento:</strong>
                            @item.DataEvento.ToString("dd/MM/yyyy")
                        </p>                      
                        
                        <p>
                            <button class="btn btn-primary" 
                                    type="button" 
                                    data-bs-toggle="collapse" 
                                    data-bs-target="#Collapse_@item.Id" aria-expanded="false" aria-controls="collapseWidthExample">
                            Fazer Inscrição
                            </button>
                        </p>
                        <div class="d-flex justify-content-center" style="min-height: 120px;">
                            <div class="collapse collapse-horizontal" id="Collapse_@item.Id">
                                <div class="card card-body" style="width: 300px;">
                                    <partial name="_PartialInscricao" model="vm" />
                                </div>
                            </div>
                        </div>


                        
                    </div>

                </div>

            </div>

            primeiro = false;
        }

    </div>

    <button class="carousel-control-prev"
            type="button"
            data-bs-target="#carouselEventos"
            data-bs-slide="prev">

        <span class="carousel-control-prev-icon"></span>

    </button>

    <button class="carousel-control-next"
            type="button"
            data-bs-target="#carouselEventos"
            data-bs-slide="next">

        <span class="carousel-control-next-icon"></span>

    </button>

</div>

