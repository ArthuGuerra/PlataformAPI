@model IEnumerable<Application.DataTransferObject.EventoDTO>;


<div id="carouselEventos" class="carousel slide" data-bs-ride="carousel">

    <div class="carousel-inner">

        @{
            bool primeiro = true;
        }

        @foreach (var item in Model)
        {
            <div class="carousel-item @(primeiro ? "active" : "")">

                <div class="text-center">

                    <img src="@item.Imagem"
                         class="d-block w-100 img-fluid"
                         alt="@item.Nome">

                    <div class="mt-3">
                        <h4>@item.Nome</h4>

                        <p>@item.Descricao</p>

                        <p>
                            <strong>Local:</strong>
                            @item.LocalEvento
                        </p>

                        <p>
                            <strong>Data do evento:</strong>
                            @item.DataEvento.ToString("dd/MM/yyyy")
                        </p>

                        <p>
                            <strong>Inscrição feita em:</strong>
                            @item.DataInscricao.ToString("dd/MM/yyyy")
                        </p>

                        <p>
                            <strong>Fazer inscrição:</strong>
                            <!-- botao de inscrição no evento-->
                        </p>
                    </div>

                </div>

            </div>

            primeiro = false;
        }

    </div>

    <button class="carousel-control-prev"
            type="button"
            data-bs-target="#carouselEventos"
            data-bs-slide="prev">

        <span class="carousel-control-prev-icon"></span>

    </button>

    <button class="carousel-control-next"
            type="button"
            data-bs-target="#carouselEventos"
            data-bs-slide="next">

        <span class="carousel-control-next-icon"></span>

    </button>

</div>