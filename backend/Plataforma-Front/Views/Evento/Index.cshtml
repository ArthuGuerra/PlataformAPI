@using Application.DataTransferObject
@using Domain.Entities
@using Plataforma_Front.ViewModels;

@model IEnumerable<Application.DataTransferObject.EventoDTO>;


<div id="carouselEventos" class="carousel slide" data-bs-ride="carousel">

    <div class="carousel-inner">

        @{
            bool primeiro = true; 
        }

        @foreach (var item in Model)
        {
            
            var vm = new EventoInscricaoViewModel
            {
                Evento = item,
                Inscricao = new InscricaoDTO(),
                User = new Usuario()
            };
            
            var evento = new Evento
            {
                Id = item.Id,
                QuantidadeDeKitsDisponiveis = 0,
                Preco = 0              
            };


            <div class="carousel-item @(primeiro ? "active" : "")">

                <div class="text-center">

                    <img src="@item.Imagem"
                         class="d-block w-100 img-fluid"
                         alt="@item.Nome">

                    <div class="mt-3">
                        <h4>@item.Nome</h4>

                        <p>
                            <strong>Descrição:</strong>
                            @item.Descricao
                        </p>
                        <p>
                            <strong>Local:</strong>
                            @item.LocalEvento
                        </p>
                        <p>
                            <strong>Data do evento:</strong>
                            @item.DataEvento.ToString("dd/MM/yyyy")
                        </p>
                        
                        <p>
                            <form asp-action="FazerInscricaoPOST" method="post" class="text-center">

                                <p>
                                    <button class="btn btn-primary"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#CollapseInscricao_@item.Id"
                                            aria-expanded="false"
                                            aria-controls="collapseWidthExample">
                                        Fazer Inscrição
                                        <i class="fa-regular fa-pen-to-square"></i>
                                    </button>
                                </p>
                                <div class="d-flex justify-content-center" style="min-height: 120px;">
                                    <div class="collapse collapse-horizontal" id="CollapseInscricao_@item.Id">
                                        <div class="card card-body" style="width: 300px;">
                                            <partial name="_PartialInscricao" model="vm" />
                                        </div>
                                    </div>
                                </div>
                            </form>
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <form asp-action="DeleteEE" method="post" class="text-center">                                    

                                    <input type="hidden" name="id" value="@item.Id" />

                                    @Html.AntiForgeryToken()

                                    <p>
                                        <button class="btn btn-primary"
                                        type="submit">
                                            Deletar Evento
                                            <i class="fa-regular fa-pen-to-square"></i>
                                        </button>
                                    </p>

                                </form>                               

                                <form asp-action="UpdateADM" method="post" class="text-center">

                                    <p>
                                        <button class="btn btn-primary"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#CollapseUpdateADM_@item.Id"
                                        aria-expanded="false"
                                        aria-controls="collapseWidthExample">
                                            Atualizar Evento ADM
                                            <i class="fa-regular fa-pen-to-square"></i>
                                        </button>
                                    </p>
                                    <div class="d-flex justify-content-center" style="min-height: 120px;">
                                        <div class="collapse collapse-horizontal" id="CollapseUpdateADM_@item.Id">
                                            <div class="card card-body" style="width: 300px;">
                                                <partial name="_PartialUpdateADM" model="evento" />
                                            </div>
                                        </div>
                                    </div>
                                </form>

                                <form asp-action="UpdateEE" method="post" class="text-center">

                                    <p>
                                        <button class="btn btn-primary"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#CollapseUpdateEE_@item.Id"
                                        aria-expanded="false"
                                        aria-controls="collapseWidthExample">
                                            Atualizar Evento
                                            <i class="fa-regular fa-pen-to-square"></i>
                                        </button>
                                    </p>
                                    <div class="d-flex justify-content-center" style="min-height: 120px;">
                                        <div class="collapse collapse-horizontal" id="CollapseUpdateEE_@item.Id">
                                            <div class="card card-body" style="width: 300px;">
                                                <partial name="_PartialUpdate" model="item" />
                                            </div> 
                                        </div>
                                    </div>
                                </form>   
                            }



                        
                    </div>

                </div>

            </div>

            primeiro = false;
        }

    </div>

    <button class="carousel-control-prev"
            type="button"
            data-bs-target="#carouselEventos"
            data-bs-slide="prev">

        <span class="carousel-control-prev-icon"></span>

    </button>

    <button class="carousel-control-next"
            type="button"
            data-bs-target="#carouselEventos"
            data-bs-slide="next">

        <span class="carousel-control-next-icon"></span>

    </button>

</div>

